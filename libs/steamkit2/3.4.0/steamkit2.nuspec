    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="System.IO.Hashing" version="10.0.1" exclude="Build,Analyzers" />
        <dependency id="ZstdSharp.Port" version="0.8.7" exclude="Build,Analyzers" />
